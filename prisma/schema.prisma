generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Video {
  id             String    @id @default(uuid())
  youtubeUrl     String
  youtubeId      String
  title          String
  thumbnailUrl   String
  author         String
  authorImageUrl String?
  subject        String
  tags           String    @default("[]") // JSON stringified array of tags
  rating         Int       @default(0) // 0 (unrated) or 1..5 stars
  isArchived     Boolean   @default(false)
  watchProgress  Float?    @default(0) // Watched percentage (0 to 100)
  lastPosition   Float?    @default(0) // Last playback position in seconds
  duration       Float?    @default(0) // Video total duration in seconds
  lastWatchedAt  DateTime? // Timestamp when video was last played
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  notes          Note[]
}

model Note {
  id             String   @id @default(uuid())
  videoId        String
  video          Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  content        String
  videoTimestamp Float?
  createdAt      DateTime @default(now())
}

model Author {
  id        String   @id @default(uuid())
  name      String   @unique
  imageUrl  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  @default("#ef4444")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
