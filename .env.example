# Gemini (optional: AI classification and free-form voice commands)
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Firebase project (Firestore database + Cloud Storage for photos)
FIREBASE_PROJECT_ID=""
FIREBASE_STORAGE_BUCKET=""          # e.g. your-project.firebasestorage.app

# Service-account credentials, used only on the server. Either:
#  a) save the downloaded key file as firebase-service-account.json in this folder (recommended), or
#  b) fill in these two values from that file ("client_email" and "private_key", NOT "private_key_id"):
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
